<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ghost_bg" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/more_back" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_previous" android:background="@android:color/transparent" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="More" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/ghost_text"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Everything MG GHOST can help you with" android:textColor="@color/ghost_muted" android:textSize="14sp"/>
    <Button android:id="@+id/more_settings" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:text="⚙ Settings &amp; Voice" android:textAllCaps="false"/>
    <Button android:id="@+id/more_youtube" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="▶ Open YouTube" android:textAllCaps="false"/>
    <Button android:id="@+id/more_chrome" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="🌐 Open Chrome / Web" android:textAllCaps="false"/>
    <Button android:id="@+id/more_maps" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="📍 Open Maps" android:textAllCaps="false"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Voice examples

• Hey Ghost, open WhatsApp
• Hey Ghost, turn on flashlight
• Hey Ghost, call Mum
• Hey Ghost, set a reminder
• Hey Ghost, search for something
• Hey Ghost, help me plan my day" android:textColor="@color/ghost_text" android:textSize="15sp"/>
</LinearLayout>
